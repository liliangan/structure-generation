{
  "name": "project-structure-generator",
  "displayName": "Project Structure Generator (项目结构生成器)",
  "description": "扫描项目文件，生成包含项目结构的文件 | Scan project files and generate a file containing the project structure",
  "version": "1.1.0",
  "publisher": "LiLiangAn-structure-generator",
  "license": "MIT",
  "icon": "images/icon.png",
  "author": {
    "name": "liliangan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liliangan/structure-generation"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:project-structure.generate",
    "onCommand:project-structure.generateDirectory",
    "onCommand:project-structure.copy",
    "onCommand:project-structure.convertSelection",
    "onCommand:project-structure.configure"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "project-structure.generate",
        "title": "%project-structure.generate%"
      },
      {
        "command": "project-structure.generateDirectory",
        "title": "%project-structure.generateDirectory%"
      },
      {
        "command": "project-structure.copy",
        "title": "%project-structure.copy%"
      },
      {
        "command": "project-structure.convertSelection",
        "title": "%project-structure.convertSelection%"
      },
      {
        "command": "project-structure.configure",
        "title": "%project-structure.configure%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "project-structure.generate",
          "group": "navigation@1"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "project-structure.generateDirectory",
          "group": "navigation@2"
        },
        {
          "when": "resourceScheme == file",
          "command": "project-structure.copy",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "project-structure.generate",
          "group": "navigation"
        },
        {
          "command": "project-structure.copy",
          "group": "navigation"
        },
        {
          "when": "editorHasSelection",
          "command": "project-structure.convertSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "projectStructure.outputFileName": {
          "type": "string",
          "default": "PROJECT_STRUCTURE",
          "description": "%configuration.outputFileName.description%"
        },
        "projectStructure.directoryOutputFileName": {
          "type": "string",
          "default": "PROJECT_STRUCTURE",
          "description": "%configuration.directoryOutputFileName.description%"
        },
        "projectStructure.outputFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "mindmap",
            "csv",
            "html"
          ],
          "default": "markdown",
          "description": "%configuration.outputFormat.description%"
        },
        "projectStructure.ignoredPatterns": {
          "type": "array",
          "default": [
            ".git",
            ".idea",
            ".vscode",
            "dist",
            "node_modules"
          ],
          "description": "%configuration.ignoredPatterns.description%"
        },
        "projectStructure.maxDepth": {
          "type": "number",
          "default": 0,
          "description": "%configuration.maxDepth.description%"
        },
        "projectStructure.autoUpdate": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.autoUpdate.description%"
        },
        "projectStructure.useGitignore": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.useGitignore.description%"
        },
        "projectStructure.excludeOutputFile": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.excludeOutputFile.description%"
        },
        "projectStructure.showStats": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showStats.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/vscode": "^1.60.0",
    "typescript": "^5.8.3"
  }
}
